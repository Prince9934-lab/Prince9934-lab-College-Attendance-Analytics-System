<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:title="Attendance Analytics"
            android:titleTextColor="@color/white"
            app:navigationIcon="@android:drawable/ic_menu_revert" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenAiPrediction"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🤖 Launch AI Attendance Risk Predictor"
                android:textSize="15sp"
                android:layout_marginBottom="24dp" />

            <!-- 1. Attendance Trend Line Chart -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="1. Attendance Trend (Line Chart)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lineChartTrend"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="24dp" />

            <!-- 2. Department Wise Pie Chart -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="2. Department-wise Attendance (Pie Chart)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pieChartDept"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginBottom="24dp" />

            <!-- 3. Subject Wise Bar Chart -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="3. Subject-wise Attendance (Bar Chart)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barChartSubject"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginBottom="24dp" />

            <!-- 4. Top Attendance Students -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="4. Top Attendance Students (>90%)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvTopStudents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading top students..."
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:padding="12dp"
                android:background="?attr/colorSurfaceVariant"
                android:layout_marginBottom="24dp" />

            <!-- 5. Defaulter Students -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="5. Defaulter Students (&lt;75%)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#F44336" />

            <TextView
                android:id="@+id/tvDefaulters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading defaulters..."
                android:textSize="14sp"
                android:textColor="#F44336"
                android:padding="12dp"
                android:background="?attr/colorSurfaceVariant"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
